# group-bot — Bothosting : copier vers /home/container/.env
# bootstrap.js → copier vers /home/container/index.js
# Startup panel : node index.js
#
# Local : cp .env.example .env  puis  npm start

# ── Serveur (obligatoire sur Bot Hosting) ─────────────────────────────────────
SERVER_PORT=21774
PORT=21774
# Hostname affiché au démarrage (optionnel), ex. prem-eu2.bot-hosting.net
BOT_PUBLIC_HOST=prem-eu2.bot-hosting.net

# ── Admins (commandes .cgroup .pp .add .savecon .sendtest .kickall .promote) ─
MANDATORY_ADMIN_PHONE=33762641473
BOT_AUTHORIZED_PHONES=33744977766,33774865543

# test = .add uniquement 0762641473 / 0744977766 / 0774865543 / 0767919166 / 0684698028
# prod = .add / .savecon / .sendfull depuis bd triee (marqueurs anti-doublon)
ADD_MODE=prod
# .add / .sendfull : 1 personne à la fois, minimum 3 s entre chaque
ADD_DELAY_MS=3000
# .savecon : 3000 contacts BD par lancement
SAVE_BATCH=3000
SAVE_DELAY_MS=800

# ── Persistance hors clone (git pull n’efface pas) ────────────────────────────
BOT_DATA_DIR=/home/container/data
WA_AUTH_DIR=/home/container/data/auth_info_baileys
# Dossier des .txt (Bot Hosting : /home/container/data/bd-triee ou /home/container/bd-triee)
BD_TRIEE_DIR=/home/container/data/bd-triee
